# Never commit a real .env file.
# TELEGRAM_BOT_TOKEN: Bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_ALLOWED_USERS: Telegram user IDs to allow; use @userinfobot to find them.
TELEGRAM_ALLOWED_USERS=

# OPENROUTER_API_KEY: API key from https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# HERMES_DASHBOARD_PASSWORD: Password for the Hermes dashboard.
HERMES_DASHBOARD_PASSWORD=
